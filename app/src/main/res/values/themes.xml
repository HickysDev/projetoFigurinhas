<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Figurinhas" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#25D366</item>
    </style>

    <!-- Tela de recorte precisa da barra de cima, onde fica o botão "Pronto" -->
    <style name="Theme.Figurinhas.Crop" parent="Theme.Material3.Dark">
        <item name="colorPrimary">#25D366</item>
        <!-- Android 15+: não desenhar a foto por baixo da barra de cima e da de navegação -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
